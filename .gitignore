__pycache__/
*.pyc
.claude/worktrees/
# Interactive-viewer HTML files (viz2d/plot2d_web.py) are regenerable
# build artifacts, multiple MB each (they inline every field's grid data
# per bias point) - not worth tracking, regenerate with
# `python3 -m viz2d.plot2d <structure.json> --interactive`.
out/**/*_viewer.html

# virtual-fab builds (python3 -m fab build): binary VTK snapshots, regenerable
out/fab_*/

# Schottky contact tables (contacts/subgrid.py): regenerable disk cache
out/.cache/

# VTK exports of the 2D drivers (--vtk): regenerable, ~0.5 MB per bias point
out/**/vtk/
